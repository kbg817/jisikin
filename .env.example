# 이 파일을 .env 로 복사한 뒤 값을 채워주세요. (.env 는 git 에 올라가지 않습니다)

# 네이버 검색 API — https://developers.naver.com/apps/#/register  (사용 API: 검색)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (선택) AI 답변 초안 — https://platform.claude.com 에서 발급
ANTHROPIC_API_KEY=

# (선택) 유튜브 · 쓰레드 — README 4-2 참고
YOUTUBE_API_KEY=
THREADS_ACCESS_TOKEN=
